    nexttile;
    hold on;
    % cond == 1
    idx1 = (cfg.coh == thiscoh(icoh)) & (cfg.cond == 1);
    data1 = resVol(idx1, :);
    plot(data1', 'Color', [0 0 1 0.05], 'LineWidth', 0.005);
