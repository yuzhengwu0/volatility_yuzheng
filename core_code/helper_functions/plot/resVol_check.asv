%% Figure 2: log_resVol
figure;
t2 = tiledlayout(1, length(coh_levels));
for i = 1:length(coh_levels)
    nexttile;
    hold on
    for j = 1:length(vol_levels)
        c = coh_levels(i);
        v = vol_levels(j);
        mask = vol_bool == v & coh == c;
        histogram(zlog_vol(mask), 'FaceColor', colors{j}, 'BinWidth', 0.25);
        title(sprintf('coh = %.2f', c/100));
    end
end
ylabel(t2, 'count')
xlabel(t2, 'log\_resVol\_mat (residual motion energy)')
title(t2, 'z-scored log\_resVol\_mat')
legend({'low volatility', 'high volatility'}, 'Location', 'northeastoutside')


%% resVol check by vol condition
figure;

bin_edges = linspace(min(resVol(:)), max(resVol(:)), 200);
cond_levels = unique(vol);

tiledlayout(length(cond_levels),1);

for i = 1:length(cond_levels)
    nexttile;
    hold on;
    
    mask = vol == cond_levels(i);  % logical index
    
    histogram(resVol, bin_edges);         % all trials
    histogram(resVol(mask,:), bin_edges);   % this coh only
    
    if cond_levels(i) == 0
        title('low vol cond');
    elseif cond_levels(i) == 256
        title('high vol cond');
    else
        title('something wrong if you see this line');
    end

    xlabel('res Vol (n*50)');
    ylabel('count');
end
legend({'all trials', 'current vol'}, 'Location', 'northeast')
title(gcf().Children(1), 'sanity check for resVol distribution in high/low vol cond')


%% resVol check by coherence 
figure;
bin_edges = linspace(min(resVol(:)), max(resVol(:)), 50);
coh_levels = unique(coh_weuse);

tiledlayout(1, length(coh_levels));

for i = 1:length(coh_levels)
    nexttile;
    hold on;
    
    mask = coh_weuse == coh_levels(i);  % logical index
    
    histogram(resVol(:), bin_edges);         % all trials
    histogram(resVol(mask,:), bin_edges);   % this coh only
    
    title(sprintf('coh = %.2f', coh_levels(i)));
    xlabel('resVol');
    ylabel('count');
end
legend({'all trials', 'current coh'}, 'Location', 'northeast')
title(gcf().Children(1), 'sanity check for raw volatility distribution in each coh level')


%% figure 4 vanessa trying resVol mean
resVol_mean = mean(resVol,2);
resVol_high_mean = resVol_mean(highvol == 1);
resVol_low_mean = resVol_mean(lowvol == 1);

figure;
hold on;
histogram(resVol_mean)
histogram(resVol_high_mean)
title("resVol mean (blue); resVol high mean (brown)")

figure;
hold on;
histogram(resVol_mean)
histogram(resVol_low_mean)
title("resVol mean (blue); resVol low mean (brown)")


%% RAW vol check by volatility levels
figure;

% bin_edges = linspace(0, max(STD_norm(:)), 100);
cond_levels = unique(vol);

tiledlayout(length(cond_levels),1);

for i = 1:length(cond_levels)
    nexttile;
    hold on;
    
    mask = vol == cond_levels(i);  % logical index
    
    histogram(STD_norm(:));         % all trials
    histogram(STD_norm(mask,:));   % this coh only
    
    if cond_levels(i) == 0
        title('low vol cond');
    elseif cond_levels(i) == 256
        title('high vol cond');
    else
        title('something wrong if you see this line');
    end

    xlabel('raw volatility');
    ylabel('count');
end
legend({'all trials', 'current cond'}, 'Location', 'northeast')
title(gcf().Children(1), 'sanity check for raw volatility distribution in high/low vol cond')


%% RAW vol check by coherence 
figure;
bin_edges = linspace(0, max(STD_norm(:)), 100);
coh_levels = unique(coh_weuse);

tiledlayout(1, length(coh_levels));

for i = 1:length(coh_levels)
    nexttile;
    hold on;
    
    mask = coh_weuse == coh_levels(i);  % logical index
    
    histogram(STD_norm(:), bin_edges);         % all trials
    histogram(STD_norm(mask,:), bin_edges);   % this coh only
    
    title(sprintf('coh = %.2f', coh_levels(i)));
    xlabel('raw volatility');
    ylabel('count');
end
legend({'all trials', 'current coh'}, 'Location', 'northeast')
title(gcf().Children(1), 'sanity check for raw volatility distribution in each coh level')

